{
  "config": {
    "step": {
      "user": {
        "title": "Yoto"
      },
      "reauth_confirm": {
        "title": "Re-authenticate with Yoto"
      }
    },
    "progress": {
      "wait_for_auth": "To authenticate, open the following URL and log in with your Yoto account:\n\n{url}\n\nEnter the code: **{code}**"
    },
    "abort": {
      "invalid_auth": "Authentication failed. Please try again.",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "single_instance_allowed": "[%key:common::config_flow::abort::single_instance_allowed%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "scan_interval": "Polling interval (minutes)"
        },
        "data_description": {
          "scan_interval": "How often to poll the Yoto API for player updates (1-60 minutes)."
        }
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "online": {
        "name": "Online"
      },
      "charging": {
        "name": "Charging"
      },
      "bluetooth_audio_connected": {
        "name": "Bluetooth audio connected"
      },
      "sleep_timer": {
        "name": "Sleep timer"
      },
      "day_mode": {
        "name": "Day mode"
      },
      "audio_device_connected": {
        "name": "Audio device connected"
      },
      "night_light_mode": {
        "name": "Night light mode"
      }
    },
    "light": {
      "day_ambient_colour": {
        "name": "Day ambient colour"
      },
      "night_ambient_colour": {
        "name": "Night ambient colour"
      }
    },
    "number": {
      "day_max_volume_limit": {
        "name": "Day max volume limit"
      },
      "night_max_volume_limit": {
        "name": "Night max volume limit"
      },
      "day_display_brightness": {
        "name": "Day display brightness"
      },
      "night_display_brightness": {
        "name": "Night display brightness"
      },
      "sleep_timer": {
        "name": "Sleep timer"
      }
    },
    "select": {
      "display_dim_timeout": {
        "name": "Battery saver",
        "state": {
          "0": "Off",
          "15": "15 seconds",
          "30": "30 seconds",
          "60": "1 minute",
          "180": "3 minutes",
          "300": "5 minutes"
        }
      },
      "shutdown_timeout": {
        "name": "Auto power off",
        "state": {
          "0": "Off",
          "900": "15 minutes",
          "1800": "30 minutes",
          "3600": "1 hour",
          "7200": "2 hours",
          "10800": "3 hours"
        }
      }
    },
    "sensor": {
      "battery": {
        "name": "Battery"
      },
      "temperature": {
        "name": "Temperature"
      },
      "wifi_signal_strength": {
        "name": "WiFi signal strength"
      },
      "firmware_version": {
        "name": "Firmware version"
      },
      "last_updated_at": {
        "name": "Last updated at"
      },
      "ambient_light": {
        "name": "Ambient light"
      },
      "battery_temperature": {
        "name": "Battery temperature"
      }
    },
    "switch": {
      "day_auto_brightness": {
        "name": "Day auto brightness"
      },
      "night_auto_brightness": {
        "name": "Night auto brightness"
      },
      "end_of_track_sleep": {
        "name": "End of track sleep"
      },
      "alarm": {
        "name": "Alarm {number}"
      },
      "hour_format": {
        "name": "24-hour clock"
      },
      "bt_headphones_enabled": {
        "name": "Bluetooth pairing"
      },
      "headphones_volume_limited": {
        "name": "Headphone volume limit"
      }
    },
    "time": {
      "day_mode_time": {
        "name": "Day mode time"
      },
      "night_mode_time": {
        "name": "Night mode time"
      }
    }
  },
  "exceptions": {
    "auth_failed": {
      "message": "Authentication failed. Please re-authenticate."
    },
    "api_failed": {
      "message": "Failed to connect to the Yoto API."
    }
  },
  "services": {
    "update": {
      "name": "Update",
      "description": "Force an immediate data refresh from the Yoto API.",
      "fields": {
        "config_entry": {
          "name": "Config entry",
          "description": "The Yoto config entry to refresh."
        }
      }
    }
  }
}
